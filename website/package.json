{
  "name": "kid-starterpack-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static Markdown driven catalog",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
