    "validate": "node ../scripts/validate.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.9",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "svelte": "5.57.3",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "@types/sanitize-html": "2.16.2"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "15.0.12",
    "sanitize-html": "2.18.2"
