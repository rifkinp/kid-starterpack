{
  "name": "kid-starterpack-maintenance",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "lint": "oxlint scripts website/src templates packages --deny-warnings",
    "verify:extraction": "node scripts/verify-extraction.mjs",
    "verify:giget": "node scripts/verify-giget.mjs",
    "test:cli": "node --test packages/create-kid-starter/test/*.test.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs"
  },
  "devDependencies": {
    "giget": "3.3.1",
    "gray-matter": "4.0.3",
    "oxlint": "1.93.0"
  }
}
