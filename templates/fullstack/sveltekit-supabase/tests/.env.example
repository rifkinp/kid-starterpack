# Test runner only. Never place these values in PUBLIC_ variables or production.
# Apply supabase/migrations/0001_notes.sql to an isolated test project first.
KID_TEST_SUPABASE_DISPOSABLE=yes
KID_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
KID_TEST_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PUBLISHABLE_KEY
KID_TEST_SUPABASE_ADMIN_KEY=YOUR_TEST_SERVER_ONLY_ADMIN_KEY
