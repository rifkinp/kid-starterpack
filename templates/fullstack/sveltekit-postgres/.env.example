DATABASE_URL=postgres://kid:kid@localhost:5432/kid
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret-minimum-32-characters
BETTER_AUTH_URL=http://localhost:5173
# Verification is required by default. Only disable explicitly for local experiments.
REQUIRE_EMAIL_VERIFICATION=true
# Required in production for verification/reset emails. Dev logs links without these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@your-verified-domain.com
