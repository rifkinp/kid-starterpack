{
  "name": "kid-sveltekit-postgres",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portable PostgreSQL plus Better Auth starter",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:push": "drizzle-kit push",
    "auth:migrate": "bunx auth@1.7.25 migrate --config ./src/lib/server/auth.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "6.0.0",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "svelte": "5.57.3",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.7"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  }
}
